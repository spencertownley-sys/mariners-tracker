# ---- Supabase (web + worker) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server / worker only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection (worker + migrations). Use the Supabase pooler URL in production.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- External hazard APIs (worker) ----
# Free registration: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
# Free registration: https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=
# NWS requires a descriptive User-Agent on every request: "(app name, contact email)"
NWS_USER_AGENT=(AllClear, you@example.com)
# Optional override of the NIFC/WFIGS ArcGIS incident-locations endpoint (see docs/AllClear-TECH_SPEC.md §5)
NIFC_INCIDENTS_URL=

# ---- Notifications ----
# https://resend.com
RESEND_API_KEY=
RESEND_FROM="AllClear <alerts@example.com>"
# Web Push VAPID keypair. Generate once with: pnpm --filter @allclear/worker vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The public half of the VAPID key must also be visible to the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Monitoring ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Worker tuning (optional; defaults shown) ----
# PORT=8080
# POLL_USGS_MINUTES=2
# POLL_FIRMS_MINUTES=15
# POLL_NWS_ALERTS_MINUTES=10
# POLL_NWS_WEATHER_MINUTES=15
# POLL_AIRNOW_MINUTES=30
# POLL_NIFC_MINUTES=20
